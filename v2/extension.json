{
  "schemaVersion": 3,
  "id": "com.tezbar.native.datetime-format-converter",
  "slug": "datetime-format-converter",
  "name": "Date Format Converter",
  "version": "2.0.0",
  "description": "Convert timestamps and datetime strings into various formats.",
  "icon": "resources/command-icon.png",
  "runtime": "rust",
  "execution": "process",
  "protocolVersion": 1,
  "repository": "https://github.com/almatkai/datetime-format-converter",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "commands": [
    {
      "name": "index",
      "title": "Format Date",
      "description": "Convert timestamps and datetime strings into various formats.",
      "mode": "view",
      "preferences": [
        {
          "name": "autoPasteClipboard",
          "title": "Auto Paste",
          "description": "Automatically paste clipboard content to search bar when the command is executed",
          "type": "checkbox",
          "required": false,
          "label": "Auto Paste Clipboard Content",
          "default": true
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "refreshMs": null,
      "concurrency": "serialize",
      "timeoutMs": 10000,
      "icon": "resources/command-icon.png"
    },
    {
      "name": "insert-natural-language-date",
      "title": "Insert Natural Language Date",
      "description": "Convert a natural language prompt into a formatted date and insert it into the frontmost application",
      "mode": "no-view",
      "arguments": [
        {
          "name": "prompt",
          "placeholder": "Date Prompt",
          "type": "text",
          "required": false
        },
        {
          "name": "format",
          "placeholder": "Date Format",
          "type": "text",
          "required": false
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "refreshMs": null,
      "concurrency": "serialize",
      "timeoutMs": 10000,
      "icon": "resources/command-icon.png"
    }
  ],
  "preferences": [
    {
      "name": "isoDate",
      "title": "Select Preferred Date Time Formats",
      "type": "checkbox",
      "required": false,
      "label": "YYYY-MM-DD",
      "description": "2024-11-01",
      "default": true
    },
    {
      "name": "isoDateTime",
      "type": "checkbox",
      "required": false,
      "label": "YYYY-MM-DD HH:mm:ss",
      "description": "2024-11-01 01:56:27",
      "default": true
    },
    {
      "name": "formatWithMillis",
      "type": "checkbox",
      "required": false,
      "label": "YYYY-MM-DD HH:mm:ss.SSS",
      "description": "2024-11-01 01:56:27.000",
      "default": true
    },
    {
      "name": "formatWithTimezone",
      "type": "checkbox",
      "required": false,
      "label": "YYYY-MM-DD HH:mm:ssZ",
      "description": "2024-11-01 01:56:27+05:30",
      "default": true
    },
    {
      "name": "isoFormat",
      "type": "checkbox",
      "required": false,
      "label": "ISO 8601 (default)",
      "description": "2024-11-01T01:56:27+05:30",
      "default": true
    },
    {
      "name": "utcIsoFormat",
      "type": "checkbox",
      "required": false,
      "label": "UTC ISO 8601",
      "description": "2024-10-31T20:26:27Z",
      "default": true
    },
    {
      "name": "unixTimestamp",
      "type": "checkbox",
      "required": false,
      "label": "Unix Timestamp (seconds)",
      "description": "1730406387",
      "default": true
    },
    {
      "name": "unixMillis",
      "type": "checkbox",
      "required": false,
      "label": "Unix Timestamp (milliseconds)",
      "description": "1730406387000",
      "default": true
    },
    {
      "name": "localizedShortDate",
      "type": "checkbox",
      "required": false,
      "label": "Localized (L)",
      "description": "11/01/2024",
      "default": true
    },
    {
      "name": "localizedShortDateTime",
      "type": "checkbox",
      "required": false,
      "label": "Localized (L LT)",
      "description": "11/01/2024 1:56 AM",
      "default": true
    },
    {
      "name": "localizedFullDateTime",
      "type": "checkbox",
      "required": false,
      "label": "Localized (LLL)",
      "description": "November 1, 2024 1:56 AM",
      "default": true
    },
    {
      "name": "localizedLongDateTime",
      "type": "checkbox",
      "required": false,
      "label": "Localized (LLLL)",
      "description": "Friday, November 1, 2024 1:56 AM",
      "default": true
    },
    {
      "name": "localizedTime",
      "type": "checkbox",
      "required": false,
      "label": "Localized Time (LT)",
      "description": "1:56 AM\u200e",
      "default": true
    },
    {
      "name": "localizedSecondsTime",
      "type": "checkbox",
      "required": false,
      "label": "Localized Time with Seconds (LTS)",
      "description": "1:56:27 AM",
      "default": true
    },
    {
      "name": "naturalLanguageDateFormat",
      "title": "Default Natural Language Date Format",
      "type": "textfield",
      "default": "YYYY-MM-DD",
      "description": "Default date format string to use when converting natural language dates.",
      "required": false
    }
  ],
  "replaces": [
    "com.tezbar.datetime-format-converter",
    "raycast.datetime-format-converter"
  ],
  "capabilities": [
    "clipboard.read",
    "clipboard.write",
    "clipboard.pasteText",
    "settings.open",
    "window.visibility"
  ],
  "artifacts": {},
  "verification": [
    {
      "platform": "macOS",
      "state": "not-run",
      "note": "Feature branch review; no installation, native GUI or release acceptance."
    },
    {
      "platform": "Windows",
      "state": "not-run",
      "note": "Feature branch review; no installation, native GUI or release acceptance."
    }
  ]
}
