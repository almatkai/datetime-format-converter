{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "date-format-converter",
  "title": "Date Format Converter",
  "description": "Convert timestamps and datetime strings into various formats.",
  "icon": "assets/command-icon.png",
  "author": "almatkai",
  "categories": ["Developer Tools"],
  "contributors": [
    "yifengkuaijian",
    "pernielsentikaer",
    "hemang_kinra",
    "jose-elias-alvarez",
    "bestemic",
    "ridemountainpig"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Format Date",
      "description": "Convert timestamps and datetime strings into various formats.",
      "mode": "view",
      "preferences": [
        {
          "name": "autoPasteClipboard",
          "title": "Auto Paste",
          "description": "Automatically paste clipboard content to search bar when the command is executed",
          "type": "checkbox",
          "required": false,
          "label": "Auto Paste Clipboard Content",
          "default": true
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ]
    },
    {
      "name": "insert-natural-language-date",
      "title": "Insert Natural Language Date",
      "description": "Convert a natural language prompt into a formatted date and insert it into the frontmost application",
      "mode": "no-view",
      "arguments": [
        {
          "name": "prompt",
          "placeholder": "Date Prompt",
          "type": "text",
          "required": false
        },
        {
          "name": "format",
          "placeholder": "Date Format",
          "type": "text",
          "required": false
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "preferences": [
    {
      "name": "isoDate",
      "title": "Select Preferred Date Time Formats",
      "type": "checkbox",
      "required": false,
      "label": "YYYY-MM-DD",
      "description": "2024-11-01",
      "default": true
    },
    {
      "name": "isoDateTime",
      "type": "checkbox",
      "required": false,
      "label": "YYYY-MM-DD HH:mm:ss",
      "description": "2024-11-01 01:56:27",
      "default": true
    },
    {
      "name": "formatWithMillis",
      "type": "checkbox",
      "required": false,
      "label": "YYYY-MM-DD HH:mm:ss.SSS",
      "description": "2024-11-01 01:56:27.000",
      "default": true
    },
    {
      "name": "formatWithTimezone",
      "type": "checkbox",
      "required": false,
      "label": "YYYY-MM-DD HH:mm:ssZ",
      "description": "2024-11-01 01:56:27+05:30",
      "default": true
    },
    {
      "name": "isoFormat",
      "type": "checkbox",
      "required": false,
      "label": "ISO 8601 (default)",
      "description": "2024-11-01T01:56:27+05:30",
      "default": true
    },
    {
      "name": "utcIsoFormat",
      "type": "checkbox",
      "required": false,
      "label": "UTC ISO 8601",
      "description": "2024-10-31T20:26:27Z",
      "default": true
    },
    {
      "name": "unixTimestamp",
      "type": "checkbox",
      "required": false,
      "label": "Unix Timestamp (seconds)",
      "description": "1730406387",
      "default": true
    },
    {
      "name": "unixMillis",
      "type": "checkbox",
      "required": false,
      "label": "Unix Timestamp (milliseconds)",
      "description": "1730406387000",
      "default": true
    },
    {
      "name": "localizedShortDate",
      "type": "checkbox",
      "required": false,
      "label": "Localized (L)",
      "description": "11/01/2024",
      "default": true
    },
    {
      "name": "localizedShortDateTime",
      "type": "checkbox",
      "required": false,
      "label": "Localized (L LT)",
      "description": "11/01/2024 1:56 AM",
      "default": true
    },
    {
      "name": "localizedFullDateTime",
      "type": "checkbox",
      "required": false,
      "label": "Localized (LLL)",
      "description": "November 1, 2024 1:56 AM",
      "default": true
    },
    {
      "name": "localizedLongDateTime",
      "type": "checkbox",
      "required": false,
      "label": "Localized (LLLL)",
      "description": "Friday, November 1, 2024 1:56 AM",
      "default": true
    },
    {
      "name": "localizedTime",
      "type": "checkbox",
      "required": false,
      "label": "Localized Time (LT)",
      "description": "1:56 AM‎",
      "default": true
    },
    {
      "name": "localizedSecondsTime",
      "type": "checkbox",
      "required": false,
      "label": "Localized Time with Seconds (LTS)",
      "description": "1:56:27 AM",
      "default": true
    },
    {
      "name": "naturalLanguageDateFormat",
      "title": "Default Natural Language Date Format",
      "type": "textfield",
      "default": "YYYY-MM-DD",
      "description": "Default date format string to use when converting natural language dates.",
      "required": false
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "chrono-node": "^2.7.7",
    "dayjs": "^1.10.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "platforms": [
    "macOS",
    "Windows"
  ],
  "id": "com.tezbar.datetime-format-converter",
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/datetime-format-converter",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/datetime-format-converter",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
